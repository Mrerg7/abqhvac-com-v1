---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

const site = await getEntry('site', 'default');
const data = site!.data;
const crumbs = [
  { name: 'Home', url: 'https://abqhvac.com/' },
  { name: 'FAQ', url: 'https://abqhvac.com/faq/' },
];
const title = `FAQ | Buying the ${data.domain} Domain`;
const description = `Answers about buying ${data.domain}: price ${data.price}, escrow transfer, what is included, and what a domain name does not rank for you.`;
---

<BaseLayout title={title} description={description} faqs={data.faqs} crumbs={crumbs}>
  <Nav domain={data.domain} price={data.price} />
  <main id="main" class="pt-24 md:pt-28 pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="font-display text-[clamp(2.1rem,6vw,3.4rem)] font-bold tracking-tight leading-tight">
        Questions about buying abqhvac.com
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Straight answers before you open escrow. The asking price is {data.price} for the domain name only.
      </p>

      <div class="mt-10 divide-y divide-slate-800 border-y border-slate-800">
        {data.faqs.map((faq) => (
          <details class="group py-5">
            <summary class="cursor-pointer text-lg font-semibold text-white list-none flex items-start justify-between gap-4">
              <span>{faq.q}</span>
              <span class="text-orange-400 shrink-0 group-open:rotate-45 transition-transform text-2xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-slate-300 leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>

      <a href="/acquire/#inquiry" class="mt-10 inline-flex items-center justify-center min-h-12 px-6 rounded-2xl bg-orange-600 text-white font-semibold">
        Acquire abqhvac.com — {data.price}
      </a>
    </div>
  </main>
  <Footer disclaimer={data.disclaimer} email={data.email} price={data.price} footerLinks={data.footerLinks} />
  <StickyCta price={data.price} />
</BaseLayout>
