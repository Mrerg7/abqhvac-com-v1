---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroSection from '../components/HeroSection.astro';
import WhySection from '../components/WhySection.astro';
import DomainDetails from '../components/DomainDetails.astro';
import TargetBuyers from '../components/TargetBuyers.astro';
import PricingSection from '../components/PricingSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

const site = await getEntry('site', 'default');
const data = site!.data;

const title = `${data.domain} for Sale | Albuquerque HVAC Domain — ${data.price}`;
const description = `Buy ${data.domain}, a 7-character Albuquerque HVAC .com, for ${data.price}. Escrow transfer. The domain name only — not a service company.`;
---

<BaseLayout title={title} description={description} includeProduct={true}>
  <Nav domain={data.domain} price={data.price} />
  <main id="main">
    <HeroSection
      domain={data.domain}
      heroImage={data.heroImage}
      trustBadge={data.trustBadge}
      trustPoints={data.trustPoints}
      headline={data.heroHeadline}
      description={data.heroDescription}
      price={data.price}
    />
    <DomainDetails details={data.domainDetails} />
    <WhySection
      headline={data.whyHeadline}
      subheadline={data.whySubheadline}
      cards={data.valueCards}
    />
    <PricingSection price={data.price} includes={data.pricingIncludes} />
    <ProcessSection />
    <TargetBuyers buyers={data.targetBuyers} />
    <ContactSection
      email={data.email}
      emailSubject={data.ctaEmailSubject}
      price={data.price}
    />
  </main>
  <Footer
    disclaimer={data.disclaimer}
    email={data.email}
    price={data.price}
    footerLinks={data.footerLinks}
  />
  <StickyCta price={data.price} href="#inquiry" />
</BaseLayout>
