---
import Icon from './Icon.astro';

interface Props {
  price: string;
  includes: string[];
}

const { price, includes } = Astro.props;
---

<section id="pricing" class="max-w-screen-xl mx-auto px-4 sm:px-6 py-14 border-t border-slate-800">
  <div class="max-w-xl mx-auto text-center">
    <p class="text-orange-400 font-semibold tracking-[0.18em] text-xs sm:text-sm mb-3 uppercase">Buy it now</p>
    <p class="text-5xl sm:text-7xl font-display font-bold tracking-tighter mb-3">{price}</p>
    <p class="text-lg sm:text-xl text-slate-300 mb-8">One payment. You own the .com.</p>

    <div class="glass-card p-6 sm:p-8 text-left">
      <h2 class="font-semibold mb-4 text-lg">The sale includes</h2>
      <ul class="space-y-3 text-sm sm:text-base">
        {includes.map((item) => (
          <li class="flex items-start gap-x-3">
            <Icon name="check" class="w-4 h-4 text-orange-400 mt-1 shrink-0" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <a href="/acquire/#inquiry" class="mt-6 inline-flex w-full items-center justify-center min-h-12 rounded-2xl bg-orange-600 hover:bg-orange-500 text-white font-semibold">
        Start the purchase
      </a>
      <p class="mt-4 text-xs text-slate-500 leading-relaxed">
        Not included: an operating company, contractor license, phone number, reviews, or search rankings.
        <a href="/faq/" class="text-orange-400 hover:text-orange-300">Read the FAQ</a>.
      </p>
    </div>
  </div>
</section>
