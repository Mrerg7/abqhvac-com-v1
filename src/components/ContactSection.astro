---
import Icon from './Icon.astro';

interface Props {
  email: string;
  emailSubject: string;
  price: string;
}

const { email, emailSubject, price } = Astro.props;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(emailSubject)}`;
---

<section id="inquiry" class="max-w-screen-xl mx-auto px-4 sm:px-6 py-16 border-t border-slate-800">
  <div class="max-w-xl mx-auto">
    <h2 class="section-title mb-3 text-center">Acquire abqhvac.com</h2>
    <p class="text-center text-slate-400 mb-8 text-balance">
      Asking price is <strong class="text-white font-semibold">{price}</strong>. Include your company so the reply can confirm the transfer.
    </p>

    <form id="inquiry-form" class="space-y-4" data-email={email} novalidate>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="contact-name" class="text-sm text-slate-400 block mb-2">Full name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required
                 class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 min-h-12 text-base focus:border-orange-600 focus:outline-none" />
        </div>
        <div>
          <label for="contact-company" class="text-sm text-slate-400 block mb-2">Company</label>
          <input id="contact-company" name="company" type="text" autocomplete="organization" required
                 class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 min-h-12 text-base focus:border-orange-600 focus:outline-none" />
        </div>
      </div>

      <div>
        <label for="contact-email" class="text-sm text-slate-400 block mb-2">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required
               class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 min-h-12 text-base focus:border-orange-600 focus:outline-none" />
      </div>

      <div>
        <label for="contact-phone" class="text-sm text-slate-400 block mb-2">Phone <span class="text-slate-500">(optional)</span></label>
        <input id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel"
               class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 min-h-12 text-base focus:border-orange-600 focus:outline-none" />
      </div>

      <div>
        <label for="contact-intent" class="text-sm text-slate-400 block mb-2">Intent</label>
        <select id="contact-intent" name="intent" required
                class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 min-h-12 text-base focus:border-orange-600 focus:outline-none">
          <option value="Acquire at the asking price of $18,500">I want to buy it at {price}</option>
          <option value="Question before purchase">I have a question before buying</option>
        </select>
      </div>

      <div>
        <label for="contact-message" class="text-sm text-slate-400 block mb-2">Message</label>
        <textarea id="contact-message" name="message" rows="4" required
                  class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 py-3 text-base focus:border-orange-600 focus:outline-none resize-y"
                  placeholder="Where the company operates, and the registrar you would transfer into."></textarea>
      </div>

      <p id="form-error" class="hidden text-sm text-red-300" role="alert"></p>

      <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white font-semibold min-h-12 rounded-2xl text-base sm:text-lg">
        Send inquiry
      </button>
    </form>

    <div id="inquiry-success" class="hidden glass-card p-6 sm:p-8 text-center">
      <h3 class="text-2xl font-display font-semibold mb-2">Your email app should open</h3>
      <p class="text-slate-400 mb-5 text-sm sm:text-base">If it does not, copy this note and send it to <span id="success-email" class="text-orange-300"></span>.</p>
      <textarea id="success-body" readonly rows="8" class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 text-sm text-left text-slate-300"></textarea>
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <button id="copy-inquiry" type="button" class="flex-1 min-h-12 rounded-2xl bg-white text-slate-950 font-semibold">Copy message</button>
        <a id="success-mailto" class="flex-1 min-h-12 rounded-2xl border border-slate-700 inline-flex items-center justify-center font-semibold" href={mailtoHref}>Open email</a>
      </div>
      <p id="copy-status" class="mt-3 text-sm text-slate-400" aria-live="polite"></p>
    </div>

    <p class="text-center pt-5 text-sm text-slate-500">
      or email
      <a href={mailtoHref} class="text-orange-400 hover:text-orange-300 font-medium">{email}</a>
    </p>
    <p class="mt-4 flex items-start gap-2 text-xs text-slate-500 leading-relaxed">
      <Icon name="shield" class="w-4 h-4 mt-0.5 shrink-0 text-orange-400" />
      <span>Payment goes through escrow, not this form. Submitting only prepares an email to the seller.</span>
    </p>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const success = document.getElementById('inquiry-success');
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form || !success) return;

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const company = String(data.get('company') || '').trim();
    const buyerEmail = String(data.get('email') || '').trim();
    const phone = String(data.get('phone') || '').trim();
    const intent = String(data.get('intent') || '').trim();
    const message = String(data.get('message') || '').trim();
    const salesEmail = form.dataset.email || '';

    if (!name || !company || !buyerEmail || !message) {
      errorEl?.classList.remove('hidden');
      if (errorEl) errorEl.textContent = 'Name, company, email, and message are required.';
      return;
    }

    const subject = `Inquiry for abqhvac.com — ${name} / ${company}`;
    const body = [
      `Name: ${name}`,
      `Company: ${company}`,
      `Email: ${buyerEmail}`,
      `Phone: ${phone || 'not provided'}`,
      `Intent: ${intent}`,
      '',
      message,
    ].join('\n');

    const mailto = `mailto:${salesEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const successBody = document.getElementById('success-body') as HTMLTextAreaElement | null;
    const successEmail = document.getElementById('success-email');
    const successMailto = document.getElementById('success-mailto');
    if (successBody) successBody.value = `To: ${salesEmail}\nSubject: ${subject}\n\n${body}`;
    if (successEmail) successEmail.textContent = salesEmail;
    if (successMailto) successMailto.setAttribute('href', mailto);

    form.classList.add('hidden');
    success.classList.remove('hidden');
    window.location.href = mailto;
  });

  document.getElementById('copy-inquiry')?.addEventListener('click', async () => {
    const successBody = document.getElementById('success-body') as HTMLTextAreaElement | null;
    const status = document.getElementById('copy-status');
    if (!successBody) return;
    try {
      await navigator.clipboard.writeText(successBody.value);
      if (status) status.textContent = 'Copied.';
    } catch {
      successBody.focus();
      successBody.select();
      if (status) status.textContent = 'Select the message and copy it.';
    }
  });
</script>
