---
import Icon from './Icon.astro';

interface Props {
  disclaimer: string;
  email: string;
  price: string;
  footerLinks: { label: string; href: string }[];
}

const { disclaimer, email, price, footerLinks } = Astro.props;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent('Inquiry for abqhvac.com acquisition')}`;
---

<footer class="border-t border-white/10 bg-slate-950">
  <div class="border-b border-white/5">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-10">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="max-w-xl">
          <p class="text-xs font-bold tracking-[0.16em] text-orange-400 uppercase mb-3">Domain for sale</p>
          <h2 class="text-2xl sm:text-3xl font-display font-bold tracking-tight mb-2">
            Own <span class="text-orange-400">abqhvac.com</span>
          </h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            A short Albuquerque HVAC .com. {price} for the domain name, transferred by escrow.
          </p>
        </div>
        <div class="flex flex-col items-start lg:items-end gap-3 w-full lg:w-auto">
          <div class="text-3xl font-display font-bold tracking-tight">{price}</div>
          <a href={mailtoHref}
             class="inline-flex w-full lg:w-auto items-center justify-center gap-x-2 px-5 min-h-12 rounded-2xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm">
            <Icon name="mail" class="w-4 h-4" />
            <span class="break-all">{email}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-6">
    <div class="bg-slate-900/50 border border-white/5 rounded-2xl p-5 mb-6">
      <div class="flex items-start gap-x-3">
        <Icon name="info" class="w-4 h-4 text-orange-400 mt-0.5 shrink-0" />
        <p class="text-xs text-slate-500 leading-relaxed">{disclaimer}</p>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-y-3 text-center md:text-left">
      <p class="text-xs text-slate-500">
        &copy; 2026 abqhvac.com. Domain offered by the current registrant.
      </p>
      <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-slate-400">
        {footerLinks.map((link) => (
          <a href={link.href} class="hover:text-slate-200 min-h-11 inline-flex items-center"
             target={link.href.startsWith('http') ? '_blank' : undefined}
             rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
