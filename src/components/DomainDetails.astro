---
interface Detail {
  label: string;
  value: string;
}

interface Props {
  details: Detail[];
}

const { details } = Astro.props;
---

<section aria-label="Domain facts" class="max-w-screen-xl mx-auto px-4 sm:px-6 py-8">
  <dl class="glass-card p-5 sm:p-8 grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-6">
    {details.map((detail) => (
      <div class="min-w-0">
        <dt class="text-sm text-slate-400 mb-1">{detail.label}</dt>
        <dd class="text-lg sm:text-2xl font-semibold break-words">{detail.value}</dd>
      </div>
    ))}
  </dl>
</section>
