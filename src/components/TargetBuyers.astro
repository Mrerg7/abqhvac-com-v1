---
import Icon from './Icon.astro';

interface Props {
  buyers: string[];
}

const { buyers } = Astro.props;
---

<section class="max-w-screen-xl mx-auto px-4 sm:px-6 py-14 border-t border-slate-800">
  <h2 class="section-title mb-8">Who this name fits</h2>
  <ul class="grid md:grid-cols-2 gap-x-8 gap-y-4 text-base sm:text-lg">
    {buyers.map((buyer) => (
      <li class="flex items-start gap-x-3">
        <Icon name="check" class="w-5 h-5 text-orange-400 mt-1 shrink-0" />
        <span>{buyer}</span>
      </li>
    ))}
  </ul>
</section>
