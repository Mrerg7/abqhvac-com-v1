---
import Icon from './Icon.astro';

interface Props {
  domain: string;
  heroImage: string;
  trustBadge: string;
  trustPoints: string[];
  headline: string;
  description: string;
  price: string;
}

const { domain, heroImage, trustBadge, trustPoints, headline, description, price } = Astro.props;
---

<header class="pt-24 pb-12 md:pt-32 md:pb-16">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <div class="lg:hidden mb-6">
          <img
            src={heroImage}
            alt={`${domain} logo for an Albuquerque HVAC domain name`}
            class="w-full max-h-44 sm:max-h-56 object-contain bg-white rounded-2xl border border-slate-800 p-4"
            width="1200"
            height="675"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="inline-flex items-center gap-x-2 bg-slate-900 border border-slate-800 rounded-full px-3 py-1.5 mb-5">
          <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
          <span class="text-sm font-medium text-orange-400">{trustBadge}</span>
        </div>

        <h1 class="font-display font-bold tracking-tighter leading-[0.95] mb-4">
          <span class="block text-[clamp(2.5rem,12vw,4.75rem)]">{headline}</span>
          <span class="mt-3 block text-xl sm:text-2xl font-semibold tracking-tight text-slate-100 text-balance">
            Albuquerque HVAC domain for sale
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-xl mb-6 leading-relaxed">
          {description}
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a href="#inquiry"
             class="inline-flex items-center justify-center bg-white hover:bg-slate-100 text-slate-950 font-semibold px-6 min-h-12 rounded-2xl text-base sm:text-lg">
            Acquire now — {price}
          </a>
          <a href="#pricing" class="inline-flex items-center justify-center gap-x-2 min-h-12 px-5 border border-slate-700 rounded-2xl text-sm">
            <span class="font-mono font-semibold">{price}</span>
            <span class="text-slate-400">USD · one-time</span>
          </a>
        </div>

        <ul class="mt-8 flex flex-col gap-2.5 text-sm text-slate-300">
          {trustPoints.map((point) => (
            <li class="flex items-start gap-x-2">
              <Icon name="check" class="w-4 h-4 mt-0.5 text-orange-400 shrink-0" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="hidden lg:block">
        <img
          src={heroImage}
          alt={`${domain} logo for an Albuquerque HVAC domain name`}
          class="w-full rounded-3xl border border-slate-800 bg-white p-8 shadow-2xl shadow-orange-900/10"
          width="1200"
          height="675"
          decoding="async"
        />
      </div>
    </div>
  </div>
</header>
