---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'check' && <polyline points="20 6 9 17 4 12" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
      <circle cx="12" cy="10" r="2.25" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </>
  )}
  {name === 'building' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="1.5" />
      <path d="M8 21v-4h8v4M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v6M12 8h.01" />
    </>
  )}
  {name === 'shield' && <path d="M12 3 5 6v6c0 4.2 2.8 7.2 7 8.5 4.2-1.3 7-4.3 7-8.5V6l-7-3z" />}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v6l4 2" />
    </>
  )}
  {name === 'key' && <path d="M14 7a4 4 0 1 0-3.9 5H8v2H6v2H4v-2.5L10.1 12A4 4 0 0 0 14 7z" />}
  {name === 'temp' && (
    <>
      <path d="M14 14.8V5a2 2 0 1 0-4 0v9.8a4 4 0 1 0 4 0z" />
      <path d="M12 9v4" />
    </>
  )}
</svg>
